sensor_pin = PC4
control = watermark
min_temp = -100
max_temp = 100

[safe_z_home]
home_xy_position = 170,170
z_hop = 5

[probe]
pin = ^!PC14
deactivate_on_each_sample = False
x_offset = 20
y_offset = -25
z_offset = 0.0
speed = 15.0
samples_result = median
samples = 2
lift_speed = 60
samples_tolerance = 1
