homing_retract_dist = 20
homing_positive_dir = False

[stepper_y]
step_pin = PB10
dir_pin = PB2
enable_pin = !PB11
microsteps = 8
gear_ratio = 2:1
rotation_distance = 40
endstop_pin = ^!PC1
position_endstop = 0
position_max = 400
