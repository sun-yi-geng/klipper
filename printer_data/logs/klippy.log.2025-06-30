	SET_PIN PIN=probe_enable VALUE=1

[gcode_macro Probe_Stow]
gcode = 
	SET_PIN PIN=probe_enable VALUE=0

[bed_mesh]
speed = 50
horizontal_move_z = 5
mesh_min = 160, 160
mesh_max = 270,270
probe_count = 3, 3

