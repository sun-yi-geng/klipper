===== Config file =====
[mcu]
serial = /dev/serial/by-id/usb-Klipper_stm32g0b1xx_2800230009504B5735313920-if00

[exclude_object]

[printer]
kinematics = cartesian
max_velocity = 300
max_accel = 1500
max_z_velocity = 8
max_z_accel = 15

[stepper_x]
step_pin = PC6
dir_pin = !PA14
enable_pin = !PC7
microsteps = 8
rotation_distance = 40
endstop_pin = ^!PC0
position_endstop = 0
position_max = 400
homing_speed = 55
homing_retract_dist = 20
homing_positive_dir = False

[stepper_y]
step_pin = PB10
dir_pin = PB2
enable_pin = !PB11
microsteps = 8
gear_ratio = 2:1
rotation_distance = 40
endstop_pin = ^!PC1
position_endstop = 0
position_max = 400
homing_speed = 50
homing_retract_dist = 20
homing_positive_dir = False

[stepper_z]
step_pin = PB0
dir_pin = !PC5
enable_pin = !PB1
microsteps = 32
rotation_distance = 4
endstop_pin = ^!PC2
position_endstop = 0
position_max = 600
position_min = -1
homing_speed = 12
second_homing_speed = 8
homing_retract_dist = 5

[extruder]
step_pin = PB3
dir_pin = !PB4
enable_pin = !PD5
microsteps = 128
gear_ratio = 1:50
rotation_distance = 40
nozzle_diameter = 2
max_extrude_cross_section = 10000000000000
max_extrude_only_distance = 1000000000000.0
filament_diameter = 4
heater_pin = PC8
sensor_pin = PA0
sensor_type = Generic 3950
control = watermark
min_temp = -200
max_temp = 275
min_extrude_temp = -200

[filament_switch_sensor extruder_filament_sensor]
switch_pin = ^!PC15

[heater_bed]
heater_pin = PD8
sensor_type = Generic 3950
sensor_pin = PC4
control = watermark
min_temp = -100
max_temp = 100

[safe_z_home]
home_xy_position = 170,170
z_hop = 5

[probe]
pin = ^!PC14
deactivate_on_each_sample = False
x_offset = 20
y_offset = -25
z_offset = 0.0
speed = 15.0
samples_result = median
samples = 2
lift_speed = 60
samples_tolerance = 1
samples_tolerance_retries = 5
activate_gcode = 
	
	Probe_Deploy
	G4 P500
deactivate_gcode = 
	
	
	Probe_Stow

[output_pin probe_enable]
pin = PA1
value = 0

[gcode_macro Probe_Deploy]
gcode = 
	SET_PIN PIN=probe_enable VALUE=1

[gcode_macro Probe_Stow]
gcode = 
	SET_PIN PIN=probe_enable VALUE=0

[bed_mesh]
speed = 50
horizontal_move_z = 5
mesh_min = 160, 160
mesh_max = 270,270
probe_count = 3, 3

[fan]
pin = PD2

[fan_generic fan1]
pin = PD3

[board_pins]
