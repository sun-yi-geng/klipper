	SET_PIN PIN=probe_enable VALUE=0

[bed_mesh]
speed = 50
horizontal_move_z = 5
mesh_min = 160, 160
mesh_max = 270,270
probe_count = 3, 3

[fan]
pin = PD2

[fan_generic fan1]
pin = PD3

[board_pins]
