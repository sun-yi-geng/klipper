[probe]
pin = ^!PC14
deactivate_on_each_sample = False
x_offset = 20
y_offset = -25
z_offset = 0.0
speed = 15.0
samples_result = median
samples = 2
lift_speed = 60
samples_tolerance = 1
samples_tolerance_retries = 5
