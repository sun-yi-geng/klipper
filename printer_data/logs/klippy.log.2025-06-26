enable_pin = !PC7
microsteps = 8
rotation_distance = 40
endstop_pin = ^!PC0
position_endstop = 0
position_max = 400
homing_speed = 55
homing_retract_dist = 20
homing_positive_dir = False

[stepper_y]
step_pin = PB10
dir_pin = PB2
enable_pin = !PB11
microsteps = 8
gear_ratio = 2:1
rotation_distance = 40
endstop_pin = ^!PC1
position_endstop = 0
position_max = 400
homing_speed = 50
homing_retract_dist = 20
homing_positive_dir = False

[stepper_z]
step_pin = PB0
dir_pin = !PC5
enable_pin = !PB1
microsteps = 32
rotation_distance = 4
endstop_pin = probe:z_virtual_endstop
position_max = 600
position_min = -1
homing_speed = 12
second_homing_speed = 8
homing_retract_dist = 5

[extruder]
step_pin = PB3
dir_pin = !PB4
enable_pin = !PD5
