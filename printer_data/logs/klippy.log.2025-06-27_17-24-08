	{ action_respond_info("Status cleared without adjustment") }
	{% endif %}
	{% set dummy = surfaces.__setitem__('endstop_z', new_endstop_z| round(6)) %}
	{% set dummy = surfaces.__setitem__('probe_z', new_probe_z|round(6)) %}
