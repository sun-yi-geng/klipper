	G0 Z{z_safe} E-1.0 F{km.travel_speed_z * 2}
	G0 X{x_safe} Y{y_safe} E-1.0 F{km.travel_speed_xy}
	
	_KM_APPLY_PRINT_OFFSET RESET=1
	{% endif %}
	
	
	G92 E0
	G1 E{"%.2f" % ((0, 2 - km.load_priming_length / 4)|min)} F1200
	M400
	{% endif %}

[gcode_macro _km_check_is_printing]
