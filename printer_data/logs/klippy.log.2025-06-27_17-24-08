[gcode_macro UNLOAD_FILAMENT]
description = Unloads filament from the extruder.
	Usage: UNLOAD_FILAMENT [LENGTH=<distance>] [SPEED=<speed>]
	[EXTRUDER=<extruder>] [MINIMUM=<temperature>]
	[BEEPS=<beep count on completion>]
