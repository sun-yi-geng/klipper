	scaled_heaters[h].minimum, scaled_heaters[h].maximum)) %}
	{% endfor %}
	{% if output %}}{action_respond_info(output|join('\n'))}{% endif %}
	{% else %}
	
	{% set HEATER = params.HEATER.lower() %}
	{% set settings = printer.configfile.settings[HEATER] %}
