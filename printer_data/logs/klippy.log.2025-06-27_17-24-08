	{% endif %}
	{% else %}
	
	{% set dummy = params.__delitem__("MESH_MIN") %}
	{% set dummy = params.__delitem__("MESH_MAX") %}
	{% endif %}
	
	{% if "MESH_MIN" in params or "MESH_MAX" in params %}
