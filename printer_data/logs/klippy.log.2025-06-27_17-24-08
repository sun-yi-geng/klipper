	mesh.min_y <= (default.mesh_min[1] + 0.5) and
	mesh.max_x >= (default.mesh_max[0] - 0.5) and
	mesh.max_y >= (default.mesh_max[1] - 0.5) and
	mesh.x_count >= default.probe_count[0] and
	mesh.y_count >= default.probe_count[-1] %}
	
