	{% set km = printer["gcode_macro _km_globals"] %}
	{% set toolhead = printer.toolhead %}
	{% set output = load_errors %}
	{% if km.park_x > toolhead.axis_maximum.x or
	km.park_x < toolhead.axis_minimum.x %}
