	{% set STATUS = (params.STATUS|lower).split(',')|map('trim')|list %}
	{% set TYPE = params.TYPE|default('ENTER')|trim|upper %}
	{% set WHEN = params.WHEN|default('PRINTING')|trim|upper %}
	{% set FILTER_ENTER =
	(params.FILTER_ENTER|default("")|trim|lower).split(',')|select()|list %}
