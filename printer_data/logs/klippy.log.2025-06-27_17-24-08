	{% if printer.extruder.can_extrude %}
	G1 E{'%.4f' % -E} F{km.load_speed}
	{% endif %}
	PARK P=2{% for k in params|select("in", "XYZ") %}{
	' '~k~'="'~params[k]~'"'}{% endfor %}
	_KM_BEEP_IF_AVAILABLE BEEPS={params.B|default(10)}
	{% else %}
	{ action_respond_info("Print not in progress") }
