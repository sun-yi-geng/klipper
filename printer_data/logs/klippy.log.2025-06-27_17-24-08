[gcode_macro park]
description = Park the toolhead
	Usage: PARK [P=<0|1|2>] [X=<pos>] [Y=<pos>] [Z=<pos>] [LAZY=<1|0>]
gcode = 
	{% set km = printer["gcode_macro _km_globals"] %}
	{% set LAZY = params.LAZY|default(1)|int %}
	{% if printer.toolhead.homed_axes != "xyz" %}
