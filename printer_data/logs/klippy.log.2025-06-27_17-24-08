	{% endfor %}
	{% set dummy = commands_height.__delitem__(key) %}
	{% endfor %}
	SET_GCODE_VARIABLE MACRO=_km_layer_run VARIABLE=commands_height VALUE="{
	commands_height|replace('\"','\\\"')}"
	_UPDATE_LAYER_COMPAT

