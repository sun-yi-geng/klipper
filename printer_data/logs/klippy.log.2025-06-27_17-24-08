	{% set dummy = output.append("%s is not valid for _KM_OPTIONS." |
	format(k)) %}
	{% endif %}
	{% elif km[k] is string %}
	SET_GCODE_VARIABLE MACRO=_km_globals VARIABLE={k
	} VALUE="'{options[k]|replace('\\','\\\\')|replace('\'','\\\'')
