	}{% endfor %}
	GCODE_AT_LAYER{% for k in params|select('in',['HEIGHT','LAYER'])|list %}{
	' ' ~ k ~ '=' ~ params[k] }{% endfor
	%} COMMAND="SET_HEATER_SCALING{% for k in filtered_params %}{
