[gcode_macro set_draw_params]
description = Sets the default parameters used by DRAW_LINE_TO.
	Usage: SET_DRAW_PARAMS [HEIGHT=<mm>] [WIDTH=<mm>] [FEEDRATE=<mm/m>]
variable_height = 0.2
variable_width = 0.0
variable_feedrate = 1200
