	WIDTH * n + y_start}"
	DRAW_LINE_TO HEIGHT="{HEIGHT}" WIDTH="{WIDTH}" X="{x_pos}" Y="{
	WIDTH * (n + 1) + y_start}"
	{% endfor %}
	{% set x_pos = PRINT_MAX[0] if purge_rows % 2 else PRINT_MIN[0] %}
