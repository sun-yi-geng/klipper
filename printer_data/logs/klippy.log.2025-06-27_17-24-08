	"extruder" : None,
	"gcode_macro _km_options" : None,
	"idle_timeout" : ("gcode", "_KM_IDLE_TIMEOUT"),
	"pause_resume" : None,
	"respond" : None,
	"save_variables" : None,
	"virtual_sdcard" :
	("on_error_gcode", "CANCEL_PRINT")
