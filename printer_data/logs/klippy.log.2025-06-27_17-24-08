	MESH_MULTIPLIER * (probe_count[-1] - 1) + 1,)|join(',')) %}
	
	BED_MESH_CLEAR
	BED_MESH_CALIBRATE_FAST {%
	for k in params|reject('in',['BED','SURFACE'])|list %}{
	' ' ~ k ~ '=' ~ params[k] }{% endfor %}
	SAVE_CONFIG
	
	
