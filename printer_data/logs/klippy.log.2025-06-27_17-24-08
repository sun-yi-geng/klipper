	{% endif %}
	
	{% set dummy = None if True else "
	{% set dummy = params.HEATER|default(e.g. extruder) %}
	{% set dummy = params.SCALE|default(1.0)|float %}
	{% set dummy = params.BUMP|default(0.0)|float %}
	{% set dummy = params.MAXIMUM|default(max_temp)|float %}
