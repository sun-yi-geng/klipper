	{% if km.load_length < 0.0 %}
	{% set dummy = output.append("load_length is negative.") %}
	{% endif %}
	{% if km.load_priming_length < 0.0 %}
	{% set dummy = output.append("load_priming_length is negative.") %}
	{% endif %}
	
	
	{% if output %}
	{ action_raise_error(output|sort|join('\nError: ')) }
