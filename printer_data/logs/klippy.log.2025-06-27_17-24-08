	{% if (not desc or (USAGE and not "Usage: "~name.upper() in desc)) and
	(HIDDEN or not name.startswith('_')) and (RENAMED or is_renamed) %}
	{% set dummy = output.append("%s&nbsp;%s: missing %s."
	| format("*" if is_renamed else "&nbsp;", name,
