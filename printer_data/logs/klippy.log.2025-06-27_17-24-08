	{% set USAGE = params.USAGE|default(0)|int %}
	{% set HIDDEN = params.HIDDEN|default(0)|int %}
	{% set RENAMED = params.RENAMED|default(0)|int %}
	{% set output = [] %}
	{%set config = printer.configfile.config %}
	{% for k in config|sort %}
	{% if k.startswith("gcode_macro") %}
	{% set name = k.split()[1] %}
