	{% elif Z_ADJUST != 0.0 %}
	{% set dummy = surfaces.available[surfaces.active].__setitem__(
	"offset", (Z_ADJUST + printer.gcode_move.homing_origin.z)|round(6)) %}
	SAVE_VARIABLE VARIABLE=bed_surfaces VALUE="{surfaces}"
