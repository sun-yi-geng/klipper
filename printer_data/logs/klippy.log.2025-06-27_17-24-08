	%} COMMAND="SET_HEATER_SCALING{% for k in filtered_params %}{
	' ' ~ k ~ '=\\\"' ~ params[k]|replace('\\','\\\\')|replace('\'','\\\'')
	|replace('\"','\\\"') ~ '\\\"'
