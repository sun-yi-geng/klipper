	{% elif km[k] is mapping %}
	{% if options[k] is not mapping %}
	{% set dummy = output.append("%s requires a mapping type." |
	format(k)) %}
	{% endif %}
	SET_GCODE_VARIABLE MACRO=_km_globals VARIABLE={k
	} VALUE="{options[k]|replace('\"','\\\"')}"
	{% elif km[k] is sequence %}
